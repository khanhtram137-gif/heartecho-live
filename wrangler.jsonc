{
  // HeartEcho Live — runs on a free Cloudflare account.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heartecho-live",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Serves everything in /public (index.html, together.html, module.html, ...)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // One Durable Object per room. The free plan requires SQLite-backed classes.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
